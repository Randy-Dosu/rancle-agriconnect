# Copy to .env (never commit) or set these in your host's dashboard.

# API
PORT=4000
HOST=0.0.0.0

# SQLite file for the API. Use an absolute path on persistent storage in production.
DB_PATH=server/data/agriconnect.db

# REQUIRED in production: a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session lifetime in seconds (default 7 days)
TOKEN_TTL_SECONDS=604800

# Seed the Ghana demo dataset when the database is empty. Set to false for real data.
SEED_ON_BOOT=true

# Where the Vite dev server proxies /api (development only)
API_TARGET=http://127.0.0.1:4000
